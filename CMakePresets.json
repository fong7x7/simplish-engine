{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "ENGINE_BUILD_TESTS": "ON" }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug — assertions on, platform default renderer",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release — shipping build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "relwithdebinfo",
      "inherits": "base",
      "displayName": "RelWithDebInfo — profiling and performance gates",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "headless",
      "inherits": "base",
      "displayName": "Headless — stub RHI backend, no GPU (determinism CI)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ENGINE_RENDERER": "STUB"
      }
    },
    {
      "name": "opengl",
      "inherits": "base",
      "displayName": "OpenGL — fallback backend verification",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENGINE_RENDERER": "OPENGL"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "ASan/UBSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    },
    {
      "name": "windows-cross",
      "inherits": "base",
      "displayName": "Windows x86_64 cross — clang-cl + xwin SDK, DX12, build only",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-x64-clang-cl.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CATCH_DISCOVER_TESTS_DISCOVERY_MODE": "PRE_TEST"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo" },
    { "name": "headless", "configurePreset": "headless" },
    { "name": "opengl", "configurePreset": "opengl" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "windows-cross", "configurePreset": "windows-cross" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "headless", "configurePreset": "headless", "output": { "outputOnFailure": true } },
    { "name": "opengl", "configurePreset": "opengl", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } }
  ]
}
