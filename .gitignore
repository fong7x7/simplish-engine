.DS_Store
.vscode
.vscode/*
.claude/worktrees/*
.claire
build
build*/
build/*
.cache
.cache/*
.autocode/
# Editor build module and tests are source code, not build artifacts
!editor/build/
!editor/build/**
!tests/**/build/
!tests/**/build/**

# Code coverage artifacts (LLVM/Clang)
*.profraw
*.profdata
*.gcda
*.gcno
*.gcov

# Autocode runtime artifacts (logs, results, locks)
autocode/results/
autocode/logs/
autocode/.locks/

# Python cache
__pycache__/
*.pyc

# Temporary test artifacts
temp/

# Temporary working checklists
clang-tidy-checklist*.md
invariant-checklist*.md
lint-checklist.md
test-failures.md
post-task-test-failures.md

# Test capture artifacts
*-capture.png

# Written by the editor at runtime when the platform offers no user data
# directory. The list belongs to whoever is running the editor, not to the
# checkout — see resolveRecentProjectsPath in src/bin/editor.
data/editor/recent-projects.json
build-checklist.md
