{
	"extraKnownMarketplaces": {
		"every-marketplace": {
			"source": {
				"source": "git",
				"url": "https://github.com/EveryInc/compound-engineering-plugin.git"
			}
		}
	},
	"enabledPlugins": {
		"compound-engineering@every-marketplace": true
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-invariants-hook.sh",
						"timeout": 30,
						"statusMessage": "Checking coding invariants..."
					}
				]
			}
		]
	}
}
